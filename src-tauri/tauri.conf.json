{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doc-doc",
  "version": "0.1.0",
  "identifier": "com.docdoc.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "doc-doc",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgNDRDNkQ4NzA5RjkxMzE0RgpSV1JFeHRod241RXhUd1M2Z2EzSjNRMUJaMTZFMG81UnFLOG52MWhidDI4NFNzTnp0RTZKRnduTA==",
      "endpoints": ["https://github.com/xz-ephyr/doc-doc/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
